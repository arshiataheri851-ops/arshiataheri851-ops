# Hugging Face sequence-classification model
SENTIMENT_MODEL_ID=HooshvareLab/bert-fa-base-uncased-sentiment-snappfood
SENTIMENT_MODEL_REVISION=8c5d0be5517c4bd5e26f785b1ad60b394a80de07

# Maximum model token sequence length
SENTIMENT_MAX_SEQUENCE_LENGTH=512

# CPU and throughput controls
SENTIMENT_INFERENCE_BATCH_SIZE=16
SENTIMENT_CPU_THREADS=2

# Optional locally; REQUIRED for a publicly exposed inference API.
# Generate a long random value and never commit the real secret.
# SENTIMENT_API_KEY=replace-with-a-long-random-secret
