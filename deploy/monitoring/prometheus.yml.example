global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/atlasrag-alerts.yml

scrape_configs:
  - job_name: atlasrag
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets: ["atlasrag:8000"]
    bearer_token_file: /etc/prometheus/secrets/atlasrag_metrics_token
    scrape_interval: 15s
