# Copy to .env. Replace all placeholders with unique, high-entropy secrets.
# Generate each value independently; never commit .env or share production keys.
SENTIMENT_API_KEY=
# JSON object mapping each tenant ID to its own random API key (minimum 32 chars).
# Example only; replace this value before starting AtlasRAG.
ATLASRAG_TENANT_API_KEYS_JSON={"demo":"REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARS"}
RELAYFORGE_API_TOKEN=
RELAYFORGE_OPERATOR_TOKEN=
# Comma-separated exact DNS hostnames permitted as webhook destinations.
RELAYFORGE_ALLOWED_HOSTS=
RELAYFORGE_ENABLE_WORKER=false
RELAYFORGE_MAX_ATTEMPTS=5
RELAYFORGE_RETRY_BASE_DELAY_SECONDS=2
