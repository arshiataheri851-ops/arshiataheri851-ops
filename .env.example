# Copy to .env. Replace all placeholders with unique, high-entropy secrets.
# Generate each value independently; never commit .env or share production keys.
SENTIMENT_API_KEY=
# PostgreSQL password: generate at least 32 random hexadecimal characters.
ATLASRAG_DB_PASSWORD=
# JSON object mapping tenant IDs to unique API keys (minimum 32 random characters each).
# Example format: {"customer-a":"a-unique-random-secret-of-at-least-32-characters"}
# Keep blank until you have generated and configured real tenant credentials.
ATLASRAG_TENANT_API_KEYS_JSON=
# Optional Prometheus scrape credential (minimum 32 random ASCII characters).
ATLASRAG_METRICS_TOKEN=
RELAYFORGE_API_TOKEN=
RELAYFORGE_OPERATOR_TOKEN=
# Comma-separated exact DNS hostnames permitted as webhook destinations.
RELAYFORGE_ALLOWED_HOSTS=
RELAYFORGE_ENABLE_WORKER=false
RELAYFORGE_MAX_ATTEMPTS=5
RELAYFORGE_RETRY_BASE_DELAY_SECONDS=2
